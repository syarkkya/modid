{
	"schemaVersion": 1,
	"id": "modid",
	"version": "${version}",
	"name": "Mod Name",
	"description": "Mod Description",
	"authors": [
		"syarkkya"
	],
	"contact": {
		"homepage": "https://modrinth.com/",
		"sources": "https://github.com/syarkkya/"
	},
	"license": "Custom",
	"icon": "assets/modid/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"me.syarkkya.modid.ModName"
		],
		"client": [
			"me.syarkkya.modid.ModNameClient"
		],
		"modmenu": [
			"me.syarkkya.modid.ModMenuIntegration"
		]
	},
	"mixins": [
		"modid.mixins.json",
		{
			"config": "modid.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.15.0",
		"minecraft": ">=1.21 <=1.21.1",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
}